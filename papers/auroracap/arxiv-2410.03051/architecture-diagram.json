{
  "version": 1,
  "paper_id": "7c5f11db06d6",
  "title": "AuroraCap：帧内合并与多帧描述",
  "kind": "architecture",
  "columns": 2,
  "nodes": [
    {
      "id": "frames",
      "title": "图像／采样视频帧",
      "lines": [
        "短边 378，保持宽高比"
      ],
      "row": 0,
      "col": 0,
      "span": 1,
      "kind": "input"
    },
    {
      "id": "query",
      "title": "描述指令",
      "lines": [
        "文字提示"
      ],
      "row": 0,
      "col": 1,
      "span": 1,
      "kind": "input"
    },
    {
      "id": "vit",
      "title": "CLIP ViT-H",
      "lines": [
        "逐帧编码空间特征"
      ],
      "row": 1,
      "col": 0,
      "span": 1,
      "kind": "encoder"
    },
    {
      "id": "tome",
      "title": "ViT 内 Token 合并",
      "lines": [
        "注意力后、MLP 前",
        "Key 相似度匹配与加权合并"
      ],
      "row": 2,
      "col": 0,
      "span": 1,
      "kind": "bridge"
    },
    {
      "id": "projector",
      "title": "两层 MLP",
      "lines": [
        "视觉特征对齐语言维度",
