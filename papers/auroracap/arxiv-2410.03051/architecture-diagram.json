      ],
      "row": 3,
      "col": 0,
      "span": 1,
      "kind": "bridge"
    },
    {
      "id": "llm",
      "title": "Vicuna-1.5-7B-16k",
      "lines": [
        "结合视觉前缀与指令"
      ],
      "row": 4,
      "col": 0,
      "span": 2,
      "kind": "backbone"
    },
    {
      "id": "out",
      "title": "自然语言描述",
      "lines": [
        "输出视频内容与事件细节"
      ],
      "row": 5,
      "col": 0,
      "span": 2,
      "kind": "output"
    }
  ],
  "edges": [
    {
      "to": "vit",
      "style": "solid",
      "from": "frames"
    },
    {
      "to": "tome",
      "style": "solid",
      "from": "vit"
    },
    {
      "to": "projector",
      "style": "solid",
      "from": "tome"
    },
    {
      "to": "llm",
      "style": "solid",
