        "每视图896×896"
      ],
      "row": 0,
      "col": 0,
      "kind": "input"
    },
    {
      "id": "text",
      "title": "文字提示",
      "lines": [
        "SentencePiece tokenizer",
        "离散token嵌入"
      ],
      "row": 0,
      "col": 1,
      "kind": "input"
    },
    {
      "id": "vision",
      "title": "SigLIP 视觉编码",
      "lines": [
