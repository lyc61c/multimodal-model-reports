        "语言训练时冻结"
      ],
      "row": 1,
      "col": 0,
      "kind": "encoder"
    },
    {
      "id": "pool",
      "title": "视觉压缩",
      "lines": [
        "4×4平均池化",
        "每视图256个向量"
      ],
      "row": 2,
      "col": 0,
      "kind": "bridge"
    },
    {
      "id": "lm",
      "title": "Gemma 3 语言主干",
      "lines": [
        "图文soft/hard token上下文",
        "5个局部层 + 1个全局层",
        "局部窗口1024 / 全局128K"
      ],
      "row": 3,
      "col": 0,
      "span": 2,
      "kind": "backbone"
    },
    {
      "id": "out",
      "title": "文字回答",
      "lines": [
        "自回归下一token预测",
        "IT版本以end_of_turn结束"
      ],
      "row": 4,
      "col": 0,
      "span": 2,
      "kind": "output"
    }
  ],
  "edges": [
    {
      "from": "image",
      "to": "vision"
    },
    {
      "from": "vision",
      "to": "pool"
    },
    {
      "from": "pool",
      "to": "lm"
    },
    {
      "from": "text",
      "to": "lm",
      "entry_side": "right"
    },
    {
      "from": "lm",
      "to": "out"
    }
